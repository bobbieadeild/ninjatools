#!/usr/bin/env bash

CONFIG_DIR="$HOME/.config/termtheme"
CONFIG_FILE="$CONFIG_DIR/theme.conf"

mkdir -p "$CONFIG_DIR"

RESET=$'\033[0m'
WHITE=$'\033[1;37m'
GREEN=$'\033[1;32m'
CYAN=$'\033[1;36m'
RED=$'\033[1;31m'
PURPLE=$'\033[1;35m'
ICE=$'\033[38;5;117m'
GOLD=$'\033[38;5;220m'
ORANGE=$'\033[38;5;208m'
YELLOW=$'\033[1;33m'

get_theme() {
    if [[ -f "$CONFIG_FILE" ]]; then
        source "$CONFIG_FILE"
        printf '%s' "${THEME:-Classic}"
    else
        printf '%s' "Classic"
    fi
}

save_theme() {
    printf 'THEME=%q\n' "$1" > "$CONFIG_FILE"
}

save_custom() {
    {
        printf 'THEME=Custom\n'
        printf 'R=%q\n' "$1"
        printf 'G=%q\n' "$2"
        printf 'B=%q\n' "$3"
    } > "$CONFIG_FILE"
}

show_menu() {

    local current
    current="$(get_theme)"

    printf '\n'
    printf '%s====================================================%s\n' "$CYAN" "$RESET"
    printf '%s             TERMINAL THEME SELECTOR               %s\n' "$CYAN" "$RESET"
    printf '%s====================================================%s\n' "$CYAN" "$RESET"
    printf '\n'

    printf '%s1)%s Classic\n' "$WHITE" "$RESET"
    printf '%s2)%s Hacker\n' "$GREEN" "$RESET"
    printf '%s3)%s Ice\n' "$ICE" "$RESET"
    printf '%s4)%s Fire\n' "$RED" "$RESET"
    printf '%s5)%s Purple\n' "$PURPLE" "$RESET"
    printf '%s6)%s GOLD\n' "$GOLD" "$RESET"
    printf '%s7)%s Orange\n' "$ORANGE" "$RESET"
    printf '%s8)%s Custom RGB\n' "$WHITE" "$RESET"
    printf '%s9)%s Reset\n' "$WHITE" "$RESET"
    printf '%s0)%s Exit\n' "$WHITE" "$RESET"

    printf '\n'
    printf 'Current theme: %s%s%s\n' "$YELLOW" "$current" "$RESET"
    printf '\n'
}

while true; do

    show_menu

    read -r -p "Choose [0-9]: " choice
    printf '\n'

    case "$choice" in

        1)
            save_theme "Classic"
            printf '%sClassic selected.%s\n' "$WHITE" "$RESET"
            ;;

        2)
            save_theme "Hacker"
            printf '%sHacker selected.%s\n' "$GREEN" "$RESET"
            ;;

        3)
            save_theme "Ice"
            printf '%sIce selected.%s\n' "$ICE" "$RESET"
            ;;

        4)
            save_theme "Fire"
            printf '%sFire selected.%s\n' "$RED" "$RESET"
            ;;

        5)
            save_theme "Purple"
            printf '%sPurple selected.%s\n' "$PURPLE" "$RESET"
            ;;

        6)
            save_theme "Gold"
            printf '%sGOLD selected.%s\n' "$GOLD" "$RESET"
            ;;

        7)
            save_theme "Orange"
            printf '%sOrange selected.%s\n' "$ORANGE" "$RESET"
            ;;

        8)
            printf '%sCustom RGB%s\n\n' "$CYAN" "$RESET"

            read -r -p "Red   [0-255]: " R
            read -r -p "Green [0-255]: " G
            read -r -p "Blue  [0-255]: " B

            if [[ "$R" =~ ^[0-9]+$ ]] &&
               [[ "$G" =~ ^[0-9]+$ ]] &&
               [[ "$B" =~ ^[0-9]+$ ]] &&
               (( R <= 255 && G <= 255 && B <= 255 )); then

                save_custom "$R" "$G" "$B"

                printf '\033[38;2;%s;%s;%smCustom RGB selected: %s,%s,%s%s\n' \
                    "$R" "$G" "$B" "$R" "$G" "$B" "$RESET"

            else
                printf '%sInvalid RGB value.%s\n' "$RED" "$RESET"
            fi
            ;;

        9)
            rm -f "$CONFIG_FILE"
            printf '%sTheme reset to your original Bash prompt.%s\n' "$GREEN" "$RESET"
            ;;

        0)
            printf 'Leaving theme selector.\n'
            exit 0
            ;;

        *)
            printf '%sInvalid selection.%s\n' "$RED" "$RESET"
            ;;

    esac

    printf '\n'
    read -r -p "Press Enter to continue..."

done
